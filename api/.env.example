# Cliniq API — copy to api/.env and fill in real values.
# Referenced by api/src/config/index.ts

# --- Required to boot ---
NODE_ENV=development
PORT=5050
DATABASE_URL=                 # Supabase / PostgreSQL connection string
JWT_SCRET=                    # note: spelling is intentional, matches config
JWT_EXPIRED_IN=1d
JWT_REFRESH_SECRET=
CLIENT__LOCAL_URL=http://localhost:3000
CLIENT_URL=http://localhost:3000
BACKEND_LOCAL_URL=http://localhost:5050
BACKEND_LIVE_URL=

# --- Cloudinary (image upload) ---
CLOUND_NAME=                  # note: spelling is intentional, matches config
API_KEY=
API_SECRET=

# --- Email (Gmail app password) ---
GMAIL_APP_EMAIL=
EMAIL_PASS=
ADMIN_EMAIL=

# --- Seeded accounts ---
DOCTOR_PASS=
DEFULT_ADMIN_DOCTOR=          # note: spelling is intentional, matches config

# --- AI features (optional) ---
GEMINI_API_KEY=

# --- Google OAuth (optional) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
